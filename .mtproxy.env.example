MTPROXY_HOST=root@SERVER_IP
PUBLIC_HOST=SERVER_IP
PUBLIC_PORT=443
INTERNAL_PORT=2398
WORKERS=1
DASHBOARD_PORT=18080
# Optional: set this if you want to keep the same Telegram proxy link after moving to a new server.
# MTPROXY_SECRET=your_32_hex_chars_secret
# Optional: set this if you want to keep the same dashboard URL token after moving to a new server.
# MTPROXY_DASHBOARD_TOKEN=your_dashboard_token
